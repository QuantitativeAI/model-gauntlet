# =============================================================================
# model-gauntlet - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# Variables already set in the environment take precedence.

# -----------------------------------------------------------------------------
# Hugging Face (required for gated models such as Llama)
# -----------------------------------------------------------------------------
HF_TOKEN=hf-y…oken

# -----------------------------------------------------------------------------
# Optional overrides
# -----------------------------------------------------------------------------
# HF_HOME: location of the Hugging Face model cache (default: ~/.cache/huggingface)
# HF_HOME=~/custom-hf-cache

# Intel GPU (oneAPI) tuning - the runner sets these defaults automatically
# before importing torch; uncomment to override:
# NEOReadDebugKeys=1
# ClDeviceOverride=0
# ONEDNN_MAX_CPU_ISA=AVX2
# ZES_ENABLE_SYSMAN=1
# ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
